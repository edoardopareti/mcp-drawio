# ---------------- LLM ----------------
# azure  -> Azure OpenAI (API key or Entra ID)
# openai -> OpenAI or any OpenAI-compatible endpoint (e.g. a local model server)
LLM_PROVIDER=azure

AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=YOUR_DEPLOYMENT_NAME
AZURE_OPENAI_API_VERSION=2024-10-21
# true = use DefaultAzureCredential (e.g. `az login`), false = use the API key below
AZURE_USE_ENTRA_ID=false
AZURE_OPENAI_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional: OpenAI-compatible endpoint, e.g. http://localhost:11434/v1
OPENAI_BASE_URL=

# Leave empty for models that do not accept a temperature parameter
LLM_TEMPERATURE=
MAX_TOOL_ROUNDS=12

# ---------------- Diagrams ----------------
# Folder holding the diagram state (.json), undo history and the generated .drawio files
DRAWIO_WORKSPACE=./diagrams
# Extra folders (separated by ; on Windows, : on Linux/macOS) from which /import may read .drawio files.
# The workspace and the current working directory are always allowed.
DRAWIO_IMPORT_DIRS=

# ---------------- Shapes & notations ----------------
# Shape catalogue produced by build_catalog.py. The bundled seed shapes are always available;
# entries in this file add to them and override seeds with the same key. Missing file = seeds only.
SHAPE_CATALOG=./catalog/shapes.json
# Optional folder with extra or overriding notation definitions (<name>.json + <name>.md)
NOTATIONS_DIR=

# ---------------- MCP ----------------
# Empty = the agent starts the MCP server itself over stdio (recommended).
# Set to e.g. http://127.0.0.1:8000/mcp to use a server started with --transport streamable-http
MCP_SERVER_URL=
